# For EC2 production: copy to .env.production on the server (never commit it).
# Production requires NODE_ENV=production, strong JWTs, and CORS_ORIGIN != *
NODE_ENV=development
# npm run dev / npm start runs all three APIs:
#   mobile → PORT_MOBILE (default 3001)
#   web    → PORT_WEB    (default 3002)
#   admin  → PORT_ADMIN  (default 3003)
PORT=8000
PORT_MOBILE=3001
PORT_WEB=3002
PORT_ADMIN=3003
API_VERSION=v1

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=budgetbrain
DB_USER=budgetbrain
DB_PASSWORD=budgetbrain

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Email (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=BudgetBrain <noreply@budgetbrain.app>

# AWS S3 & CloudFront CDN
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=budgetbrain-receipts
CLOUDFRONT_DOMAIN=

# RevenueCat Webhooks & In-App Subscriptions
REVENUECAT_WEBHOOK_AUTH_TOKEN=

# Razorpay (web checkout — mobile uses RevenueCat/store billing instead).
# Real values come from the Razorpay dashboard: RAZORPAY_KEY_ID/RAZORPAY_KEY_SECRET
# are your API keys; RAZORPAY_WEBHOOK_SECRET is set when you configure the webhook URL
# under Settings > Webhooks; RAZORPAY_PLAN_ID_MONTHLY/YEARLY are the ids of two
# recurring Plans you must create first under Subscriptions > Plans (priced to match
# PLAN_PRICES_INR in src/shared/modules/subscriptions/subscriptions.constants.ts).
# Left empty, Razorpay checkout/webhook endpoints respond with a clear "not configured"
# error instead of throwing.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_ID_MONTHLY=
RAZORPAY_PLAN_ID_YEARLY=

# Currency & Exchange Rates
EXCHANGE_RATE_API_KEY=

# OpenAI (optional — BudgetBrain AI Coach)
# Server-side only. Leave empty to use context-aware fallback replies.
# With a key set, /ai/chat uses gpt-4o-mini + the user's finance snapshot.
OPENAI_API_KEY=


# OAuth (optional — validates social login tokens; support comma-separated client IDs for web/ios/android)
# Example: 123456789-abcdef.apps.googleusercontent.com
GOOGLE_CLIENT_ID=
# Optional: Google Client Secret (only needed if backend authorization code exchange is used)
GOOGLE_CLIENT_SECRET=
# Comma-separated Apple audiences: iOS App ID and/or web Services ID
# Example: com.budgetbrain.app,com.budgetbrain.web
APPLE_CLIENT_ID=

# Monitoring & Analytics
SENTRY_DSN=
POSTHOG_API_KEY=

# Push Notifications (Expo)
EXPO_ACCESS_TOKEN=

# App
APP_URL=http://localhost:3000
# Development may use *. Production example:
# CORS_ORIGIN=https://app.yourdomain.com,https://admin.yourdomain.com
CORS_ORIGIN=*
