{
  "name": "budgetbrain-api",
  "version": "1.0.0",
  "description": "BudgetBrain - AI Powered Expense Tracking API",
  "main": "dist/web/index.js",
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "dev": "concurrently -k -n mobile,web,admin -c cyan,magenta,yellow \"PORT=${PORT_MOBILE:-3001} tsx watch src/mobile/index.ts\" \"PORT=${PORT_WEB:-3002} tsx watch src/web/index.ts\" \"PORT=${PORT_ADMIN:-3003} tsx watch src/admin/index.ts\"",
    "build": "tsc",
    "start": "concurrently -k -n mobile,web,admin -c cyan,magenta,yellow \"PORT=${PORT_MOBILE:-3001} node dist/mobile/index.js\" \"PORT=${PORT_WEB:-3002} node dist/web/index.js\" \"PORT=${PORT_ADMIN:-3003} node dist/admin/index.js\"",
    "start:mobile": "node dist/mobile/index.js",
    "start:web": "node dist/web/index.js",
    "start:admin": "node dist/admin/index.js",
    "start:pm2": "pm2 start ecosystem.config.cjs",
    "reload:pm2": "pm2 reload ecosystem.config.cjs --update-env",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:migrate:prod": "node dist/scripts/migrate.js",
    "db:seed": "tsx src/scripts/seed.ts",
    "db:seed:prod": "node dist/scripts/seed.js",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.750.0",
    "@sentry/node": "^9.5.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.16",
    "pdfkit": "^0.16.0",
    "pg": "^8.13.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.5",
    "uuid": "^11.0.3",
    "winston": "^3.19.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.17",
    "@types/pdfkit": "^0.13.9",
    "@types/uuid": "^10.0.0",
    "concurrently": "^10.0.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
