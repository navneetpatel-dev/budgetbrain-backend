{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@database/*": ["database/*"],
      "@core/*": ["src/core/*"],
      "@config/*": ["src/config/*"],
      "@modules/*": ["src/shared/modules/*"],
      "@shared/*": ["src/shared/*"],
      "@testHelpers": ["src/testHelpers/index.ts"],
      "@testHelpers/*": ["src/testHelpers/*"]
    },
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["src/**/*", "database/**/*"],
  "exclude": ["node_modules", "dist"]
}
